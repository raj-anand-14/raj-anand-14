<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Your voice, through Android's speech recognizer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Claude's API at api.anthropic.com, only. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: the apps it can open, the recognizer and the voice. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false">

        <activity
            android:name=".VoiceActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Overlay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- CleanYourTV module card: shows as a tile on Home once you choose Show. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- Stores the Claude API key sent from the PC (set-claude-key.bat). Only the ADB shell can
             send it: DUMP is a permission the shell holds and ordinary apps cannot get. -->
        <receiver
            android:name=".SetupReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
